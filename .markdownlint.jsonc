{
  // Regras de lint para a documentação do Ludens.
  "default": true,

  // Comprimento de linha: a prosa usa quebra semântica (~80 col), mas tabelas,
  // links longos e blocos de código estouram naturalmente — não é um erro.
  "MD013": false,

  // HTML inline: os arquivos *.template.md usam <placeholder> de propósito.
  "MD033": false,

  // Padrão deliberado do projeto: rótulo em negrito seguido de uma lista de
  // itens (ver product/scope.md). Não é "emphasis como heading".
  "MD036": false,

  // Mesmo padrão: a lista logo abaixo de um rótulo em negrito não precisa de
  // linha em branco no meio.
  "MD032": false
}
