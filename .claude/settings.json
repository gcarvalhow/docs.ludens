{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "enabledPlugins": {
    "core@team-ludens": true
  },
  "extraKnownMarketplaces": {
